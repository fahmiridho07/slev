{
  "expo": {
    "name": "Slev",
    "slug": "slev",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/slev-icon.png",
    "scheme": "slev",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f8f4",
          "image": "./assets/brand/slev-splash.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.slev.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/slev-adaptive-foreground.png",
        "backgroundColor": "#f7f8f4"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.slev.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["slev"]
          }
        ]
      }
    },
    "extra": {
      "privacy": {
        "storesRawNotifications": false,
        "requiresBankCredentials": false
      }
    }
  }
}