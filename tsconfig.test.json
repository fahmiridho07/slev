{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "noEmit": false,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "target": "ES2020",
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "react-native": ["./tests/shims/react-native.ts"],
      "expo-haptics": ["./tests/shims/expo-haptics.ts"]
    }
  },
  "include": [
    "src/data/spendingMemory.ts",
    "src/features/spendingMemory.types.ts",
    "src/lib/analysis.ts",
    "src/lib/financeEngine.ts",
    "src/lib/formatMoney.ts",
    "src/lib/spendingMemoryPatterns.ts",
    "src/services/**/*.ts",
    "src/features/app.types.ts",
    "src/features/budget/budgetValidation.ts",
    "src/features/settings/dataValidation.ts",
    "src/features/settings/settingsValidation.ts",
    "src/features/memory/memoryValidation.ts",
    "src/features/capture/captureValidation.ts",
    "src/features/capture/types.ts",
    "src/i18n/**/*.ts",
    "src/lib/formValidation.ts",
    "src/lib/spendingMemoryPatterns.ts",
    "src/navigation/appNavigation.ts",
    "src/lib/swipeGesture.ts",
    "src/navigation/deepLink.ts",
    "src/state/financeActions.ts",
    "src/state/financeReducer.ts",
    "src/state/shallowEqual.ts",
    "src/lib/haptics.ts",
    "tests/**/*.ts"
  ]
}
